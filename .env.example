# 이 파일을 복사해 .env 를 만들고 값을 채운다.  (copy .env.example .env)
# .env 는 .gitignore 에 포함되어 있다. API 키를 이 파일(.env.example)에 적지 말 것.
# 키를 뺀 나머지 값은 지금 운영 값이다 (11-05 기준). 복사한 뒤 API 키만 채우면 운영과 같은 설정이 된다

# ===== LLM (답변 생성, 외부 API) =====
# openai | anthropic
# 11-02 Claude 크레딧 소진으로 openai 로 전환
LLM_PROVIDER=openai

OPENAI_API_KEY=
# https://platform.openai.com/docs/models 에서 모델 ID 확인
OPENAI_MODEL=gpt-5.4-mini-2026-03-17

ANTHROPIC_API_KEY=
# 품질 우선: claude-sonnet-5-5 / 비용 우선: claude-haiku-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5

# 비워 두면 모델 기본값 사용 (일부 최신 모델은 temperature 지정을 지원하지 않음)
LLM_TEMPERATURE=

# 검색어 다듬기에 쓸 모델. LLM_PROVIDER 와 같은 회사의 모델 ID.
# 비우면 anthropic 은 claude-haiku-5-5, openai 는 답변 모델(OPENAI_MODEL)을 쓴다
REWRITE_MODEL=
# 검색어 다듬기의 effort. 비우거나 줄을 지우면 low (11-02 까지 코드 고정값)
# none 은 OpenAI 에서 생각 없이 바로 답하게 한다(gpt-5.4-mini 기본값). Claude 에서는 모델 기본값과 같다
REWRITE_EFFORT=low
# 채팅 화면에서 다듬기 응답을 기다리는 최대 시간(초). 넘으면 재시도 없이 원래 질문으로 검색한다 (평가 스크립트는 적용 안 함)
REWRITE_TIMEOUT=5

# 답변 LLM 의 effort
#   Claude: low | medium | high | xhigh | max (비우면 모델 기본값, Sonnet 은 high 와 같음)
#   OpenAI(gpt-5.4-mini): none | low | medium | high | xhigh (max 는 xhigh 로 바꿈, 비우면 none)
# 낮출수록 답하기 전에 생각하는 양이 줄어 빨라진다
# 11-02 결정값: low (docs/2026-11-02/답변평가_effort_비교.md, Claude 평가 기준)
ANSWER_EFFORT=low

# ===== 채팅 입력 =====
# 질문 최대 글자 수. 넘으면 LLM 을 부르지 않고 돌려보낸다 (긴 문서 붙여넣기가 외부로 나가는 것을 막음)
MAX_QUESTION_CHARS=300
# 후속 질문("그럼 계약직은?")을 이해하도록 다듬기·답변에 함께 보낼 같은 대화의 직전 질문 수. 0 이면 질문마다 독립 처리
# 이전 답변·발췌는 보내지 않는다. 채팅 화면의 대화 지우기로 새 주제를 시작한다
HISTORY_TURNS=2

# ===== 임베딩 (로컬) =====
# Hugging Face 모델 ID. 사내망에서 다운로드가 막히면 미리 받아 둔 로컬 폴더 경로를 입력
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu

# ===== 경로 (프로젝트 폴더 기준 상대경로 또는 절대경로) =====
DOCS_DIR=data/raw
# 분할 결과. 규정 원문이 들어가므로 git 에서 제외된 폴더에 둔다
CHUNKS_PATH=data/chunks/chunks.jsonl
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=regulations
# 평가셋 (마크다운 표). 질문·정답에 규정 내용이 들어가므로 git 에서 제외된 폴더에 둔다
EVAL_SET_PATH=data/eval/eval_set.md

# ===== 검색 =====
# LLM 에 전달할 조문 수 (외부 전송 최소화를 위해 3~5 권장)
RETRIEVER_K=4
# vector: 벡터 검색만 / hybrid: 벡터 + 키워드(BM25, Kiwi 형태소) 순위를 RRF 로 합침
RETRIEVER_MODE=vector

# ===== 리랭커 (로컬) =====
# 질문과 청크를 한 쌍씩 함께 읽어 순위를 다시 매기는 모델 (Hugging Face 모델 ID 또는 로컬 폴더 경로)
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 검색 결과 상위 몇 개를 리랭커로 다시 정렬할지. 0 이면 끈다 (후보가 많을수록 정확하지만 느리다)
# 채팅 화면(chat.py)과 답변 평가(eval_answers.py)의 기본값. 검색 평가(eval_retrieval.py)는 옵션으로만 켠다
# 11-04 결정값: 8 (docs/2026-11-04/후보모으기_비교.md, 여러 조항 Recall@4 0.76/0.69 → 0.90/0.81)
# 11-05 max8 ∪ quota 비교에서도 유지 (docs/2026-11-05/후보모으기_합집합_비교.md)
# 리랭커 입력 길이(1024토큰)는 .env 가 아니라 src/regbot/models.py 의 RERANK_MAX_LENGTH 다
RERANK_CANDIDATES=8
